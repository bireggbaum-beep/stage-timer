# Airtable Template System Configuration
# Generate a Personal Access Token at https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write
# Restrict to a single base for security

VITE_AIRTABLE_PAT=pat...
VITE_AIRTABLE_BASE_ID=app...
VITE_AIRTABLE_TABLE_NAME=Templates
